# --- Required ---------------------------------------------------------------
# MongoDB Atlas (EU region) connection string. Local: mongodb://127.0.0.1:27017/nam
DATABASE_URI=mongodb://127.0.0.1:27017/nam
# Long random string (e.g. `openssl rand -hex 32`). Never commit the real value.
PAYLOAD_SECRET=
# Public site URL, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Later phases (leave empty until each phase starts) -----------------------
# Booking API (apps/api). Public URL used by browsers (ticket picker, My Bookings, chat):
NEXT_PUBLIC_BOOKING_API_URL=http://localhost:4000
# Optional server-side override, e.g. a private network address:
BOOKING_API_URL=
# Shared secret for staff pages — must equal INTERNAL_API_KEY in apps/api (min. 24 characters):
INTERNAL_API_KEY=
# Email for the contact form and newsletter confirmations (same Resend key as apps/api)
RESEND_API_KEY=
EMAIL_FROM=
# EU file storage for images/PDFs (S3-compatible, e.g. Cloudflare R2). Empty = local disk.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Vercel uploads straight from the browser to the bucket (needs the bucket's CORS rule: sign in and open /staff/storage
# to check and fix it). On Render set S3_CLIENT_UPLOADS=true for the same behaviour.
S3_CLIENT_UPLOADS=
# Optional: public address of the bucket (r2.dev or custom domain) so videos stream directly
S3_PUBLIC_URL=
# Old WordPress site to import from (Staff → Import / npm run import:wordpress)
WP_IMPORT_URL=https://www.nordicaffairsmedia.com
# Optional cookie-free statistics (Plausible), loaded only after consent
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
