# Same MongoDB as the website (apps/web). The API reads events, tiers, promo codes and
# platform settings from the CMS collections, and owns its own booking_* collections.
DATABASE_URI=mongodb://127.0.0.1:27017/nam
PORT=4000
# Website address(es), comma-separated. The first is used in email links and Stripe redirects.
ALLOWED_ORIGINS=http://localhost:3000
# This API's public address (Render fills RENDER_EXTERNAL_URL, Vercel fills VERCEL_PROJECT_PRODUCTION_URL).
PUBLIC_API_URL=

# Vercel only: secret for the scheduled jobs (hold sweeper, SMS reminders). Any random text, 24+ characters.
CRON_SECRET=

# Payments — Stripe test keys while testing (sk_test_…, whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email via Resend. Without a key, emails are only written to the log.
RESEND_API_KEY=
EMAIL_FROM=Nordic Affairs Media <onboarding@resend.dev>
SUPPORT_EMAIL=

# Staff endpoints: same value as INTERNAL_API_KEY in apps/web (min. 24 characters)
INTERNAL_API_KEY=

# AI assistant (optional). Also switch it on in CMS → Settings → Platform settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
