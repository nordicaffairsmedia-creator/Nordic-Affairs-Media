{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{dist/**,node_modules/pdfkit/js/data/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [
    { "path": "/cron/sweep", "schedule": "* * * * *" },
    { "path": "/cron/reminders", "schedule": "*/5 * * * *" }
  ]
}
